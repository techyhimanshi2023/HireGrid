# HireGrid Backend Environment Variables
PROJECT_NAME="HireGrid API"
VERSION="1.0.0"

# Database Configuration:
# Default zero-cost local database:
DATABASE_URL="sqlite:///./hiregrid.db"
# Or connect to PostgreSQL (e.g. Docker, AWS RDS, Neon, Supabase):
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/hiregrid"

# JWT Security
SECRET_KEY="hiregrid-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Upload directory
UPLOAD_DIR="./uploads/resumes"
MAX_FILE_SIZE_BYTES=5242880
